GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
CMS_SESSION_SECRET=replace_with_a_long_random_secret
CMS_ALLOWED_USERS=herrkaefer
CMS_OAUTH_SCOPES=repo,user

# Anocus comments
ANOCUS_STORAGE_BACKEND=github
ANOCUS_HMAC_SECRET=replace_with_long_random_secret
ANOCUS_ALLOWED_ORIGIN=https://herrkaefer.com
ANOCUS_TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
ANOCUS_MAX_COMMENT_LENGTH=5000
ANOCUS_MIN_SECONDS_BETWEEN_POSTS=20
ANOCUS_MAX_POSTS_PER_HOUR=20

# GitHub discussions backend
ANOCUS_GITHUB_TOKEN=replace_with_github_token
ANOCUS_GITHUB_REPO_OWNER=herrkaefer
ANOCUS_GITHUB_REPO_NAME=blog-comments
ANOCUS_GITHUB_CATEGORY_ID=replace_with_discussion_category_id

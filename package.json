{
  "name": "herrkaefer-hugo",
  "version": "1.0.0",
  "description": "Hugo site for herrkaefer.com",
  "scripts": {
    "build": "hugo --buildDrafts --minify",
    "dev": "hugo server --buildDrafts --port 1313",
    "deploy": "hugo --buildDrafts && wrangler pages deploy public --project-name=herrkaefer-com"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}

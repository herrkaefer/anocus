[
{{- $posts := where site.RegularPages "Type" "posts" -}}
{{- range $i, $p := $posts -}}
{{- if gt $i 0 -}},{{- end -}}
{
  "uri": {{ $p.RelPermalink | jsonify }},
  "title": {{ $p.Title | jsonify }},
  "summary": {{ with $p.Params.summary }}{{ . | jsonify }}{{ else }}{{ with (partial "summary.html" $p) }}{{ . | plainify | htmlUnescape | jsonify }}{{ else }}""{{ end }}{{ end }},
  "content": {{ ($p.Plain | htmlUnescape | plainify) | jsonify }},
  "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
  "tags": {{ if $p.Params.tags }}{{ $p.Params.tags | jsonify }}{{ else }}[]{{ end }}
}
{{- end -}}
]

